superlu_dep = subproject('superlu').get_variable('superlu_dep')

py3.extension_module('_superlu',
  ['_superlumodule.c', '_superlu_utils.c', '_superluobject.c'],
  link_args: version_link_args,
  dependencies: [superlu_dep, blas_dep, np_dep],
  # SuperLU headers include "superlu_config.h", which must resolve to the one
  # generated by the subproject, so don't search this directory (where older
  # build dirs may still hold a stale copy from before the move).
  implicit_include_directories: false,
  install: true,
  subdir: 'scipy/sparse/linalg/_dsolve'
)

py3.install_sources([
    '__init__.py',
    '_add_newdocs.py',
    'linsolve.py'
  ],
  subdir: 'scipy/sparse/linalg/_dsolve'
)

subdir('tests')

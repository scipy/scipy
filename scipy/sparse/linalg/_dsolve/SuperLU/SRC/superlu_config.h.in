
#ifndef SUPERLU_CONFIG_H
#define SUPERLU_CONFIG_H

/* Enable metis */
#cmakedefine HAVE_METIS @HAVE_METIS@

/* Enable colamd */
#cmakedefine HAVE_COLAMD @HAVE_COLAMD@

/* enable 64bit index mode */
#cmakedefine XSDK_INDEX_SIZE @XSDK_INDEX_SIZE@

/* Integer type for indexing sparse matrix meta structure */
#if defined(XSDK_INDEX_SIZE) && (XSDK_INDEX_SIZE == 64)
#include <stdint.h>
#define _LONGINT 1
typedef int64_t int_t;
#else
typedef int int_t; /* default */
#endif

#ifndef SLU_BLASINT_TYPE_DEFINED
#define SLU_BLASINT_TYPE_DEFINED
/*! \brief Integer type used in the Fortran BLAS/LAPACK calling convention.
 *  Defaults to `int` (LP64 BLAS); redefine to a 64-bit integer type before
 *  including this header to link against an ILP64 BLAS/LAPACK. It links against
 *  ILP64 BLAS when building with `-Duse_ilp64=true`.
 */
#ifndef slu_blasint
#if defined(use_ilp64) && (use_ilp64==true)
typedef int64_t slu_blasint;
#else
typedef int slu_blasint;
#endif
#endif
#endif

#endif /* SUPERLU_CONFIG_H */


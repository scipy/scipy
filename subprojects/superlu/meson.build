superlu_lib = static_library('superlu',
  superlu_sources,
  superlu_config,
  c_args: superlu_c_args,
  dependencies: blas_dep,
  include_directories: superlu_inc,
  # Ensure that if we link a static library into a shared library,
  # private symbols don't get re-exported.
  gnu_symbol_visibility: 'hidden',
  install: false,
)

superlu_dep = declare_dependency(
  link_with: superlu_lib,
  include_directories: superlu_inc,
)

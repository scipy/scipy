project('superlu',
  'c',
  version : '7.0.1',
  meson_version: '>= 1.5.0',
)

blas_dep = dependency('scipy-blas')

cc = meson.get_compiler('c')

# SuperLU sources include "superlu_config.h".
# We generate it from our wrapper, which injects SciPy's configuration
# and then includes the upstream template's output.
# This lets us vendor the SuperLU sources unmodified.
superlu_config = [
  configure_file(
    input: 'superlu/SRC/superlu_config.h.in',
    output: 'superlu_config_upstream.h',
    format: 'cmake@',
    configuration: configuration_data(),
  ),
  configure_file(
    input: 'scipy_superlu_config.h',
    output: 'superlu_config.h',
    copy: true,
  ),
]

superlu_c_args = ['-DUSE_VENDOR_BLAS=1']
if host_machine.system() == 'windows'
  superlu_c_args += ['-DNO_TIMER=1']
endif
superlu_c_args += cc.get_supported_arguments(
  # SciPy's global C args, which don't apply to subprojects
  '-Wno-unused-but-set-variable',
  '-Wno-unused-function',
  '-Wno-conversion',
  '-Wno-misleading-indentation',
  # SuperLU-specific
  '-Wno-unused-variable',
  '-Wno-parentheses',
  '-Wno-unused-label',
  '-Wno-implicit-function-declaration',
  '-Wno-switch',
  '-Wno-unused-result',
  '-Wno-maybe-uninitialized',
)

# `.` provides both our config headers (source dir) and the generated
# `superlu_config.h` (build dir).
superlu_inc = include_directories('.', 'superlu/SRC')

superlu_sources = [
  'superlu/SRC/ccolumn_bmod.c',
  'superlu/SRC/ccolumn_dfs.c',
  'superlu/SRC/ccopy_to_ucol.c',

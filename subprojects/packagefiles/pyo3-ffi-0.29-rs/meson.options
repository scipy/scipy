option(
  'extension_module',
  type : 'boolean',
  value : true,   # <--- should be value : false perhaps when supported by meson-python??
  yield : true,
  description : 'Build for a Python extension module: do not link libpython on Unix ' +
                '(Meson analogue of PYO3_BUILD_EXTENSION_MODULE). Superprojects building ' +
                'extensions with py.extension_module() should enable this; the extension ' +
                'target itself provides the Python dependency. Leave false for embedding.',
)
